rules_version = '2';
// Japan Trip 2026 — who can do what.
// Owner (role 'admin'): everything. Planner: edit trip data. Traveler: view only.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    function myRole() { return get(memberDoc()).data.role; }
    function isAdmin() { return isOwner() || (isMember() && myRole() == 'admin'); }
    function isPlanner() { return isAdmin() || (isMember() && myRole() == 'planner'); }
    function canRead() { return isMember() || isOwner(); }
    function myPid() { return isMember() ? get(memberDoc()).data.get('personId', '-') : '-'; }
    function seesVis(d) { return !('vis' in d) || 'all' in d.vis || myPid() in d.vis; }

    // Who owns the trip. The first person to set it up claims it; it can never be changed from the app.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Members and their roles.
    match /members/{uid} {
      allow read: if canRead() || (signedIn() && request.auth.uid == uid);
      // Join: the owner makes themselves admin, everyone else needs a valid invite for that exact role.
      allow create: if signedIn() && request.auth.uid == uid && (
        (isOwner() && request.resource.data.role == 'admin') ||
        (request.resource.data.invite is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.role == request.resource.data.role
          && request.resource.data.role in ['planner', 'traveler'])
      );
      // The Owner changes roles and who's who. Members can update their own record, but not their role,
      // and can set their name only once, with a claim that's theirs (so two people can't take the same name).
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (request.resource.data.get('personId', null) == resource.data.get('personId', null)
            || (resource.data.get('personId', null) == null
                && request.resource.data.get('personId', null) is string
                && getAfter(/databases/$(database)/documents/claims/$(request.resource.data.personId)).data.uid == request.auth.uid)));
      allow delete: if isAdmin();
    }

    // Invite links.
    match /invites/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Activity log: only the Owner reads it; everyone's changes (incl. name picks) get logged. Nobody can edit or delete.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Uploaded tickets (compressed images / small PDFs).
    // Ticket files follow the ticket's "who can see it" list (vis: ['all'] or person ids).
    match /files/{id} {
      allow read: if canRead() && (isAdmin() || resource.data.by == request.auth.uid || seesVis(resource.data));
      allow create: if isPlanner() && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin() || (isPlanner() && resource.data.by == request.auth.uid);
      allow update: if (isAdmin() || (isPlanner() && resource.data.by == request.auth.uid))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vis']);
    }

    // Spending: only the people in the split, whoever paid, whoever added it, and the Owner.
    match /expenses/{id} {
      allow read: if canRead() && (isAdmin() || resource.data.get('by', '') == request.auth.uid
                    || resource.data.paidBy == myPid() || myPid() in resource.data.split);
      allow create: if isPlanner() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isPlanner() && (isAdmin() || resource.data.get('by', '') == request.auth.uid
                    || resource.data.paidBy == myPid() || myPid() in resource.data.split);
    }

    // Tickets & bookings: everyone, or only the people picked. The Owner and the uploader always see it.
    match /wallet/{id} {
      allow read: if canRead() && (isAdmin() || resource.data.by == request.auth.uid || seesVis(resource.data));
      allow create: if isPlanner() && request.resource.data.vis is list;
      allow update: if isAdmin() || (isPlanner() && (resource.data.by == request.auth.uid
                    || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vis'])));
      allow delete: if isAdmin() || (isPlanner() && resource.data.by == request.auth.uid);
    }

    // People (for splitting). Any member can add themselves, by name only, as part of picking their name.
    match /people/{id} {
      allow create: if isMember() && request.resource.data.by == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'order', 'by'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60
                    && getAfter(memberDoc()).data.get('personId', null) == id;
    }

    // Name claims: one person in the trip = one account. First claim wins; only the Owner can move or remove one.
    match /claims/{pid} {
      allow read: if canRead();
      allow create: if isAdmin() || (isMember() && request.resource.data.uid == request.auth.uid
                    && get(memberDoc()).data.get('personId', null) == null);
      allow update, delete: if isAdmin();
    }

    // Trip data.
    match /{col}/{id} {
      allow read: if canRead() && col in ['days','notes','tasks','people','rates','meta','shopping'];
      allow create, update: if isPlanner() && col in ['days','notes','tasks','people','rates','meta','shopping'];
      allow delete: if col in ['days','notes','tasks','rates','meta','shopping'] && isPlanner()
                    || col == 'people' && isAdmin();
    }
  }
}
