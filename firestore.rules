rules_version = '2';
// Japan Trip 2026 — who can do what.
// Admin: everything. Planner: edit trip data. Traveler: view only.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    function myRole() { return get(memberDoc()).data.role; }
    function isAdmin() { return isOwner() || (isMember() && myRole() == 'admin'); }
    function isPlanner() { return isAdmin() || (isMember() && myRole() == 'planner'); }
    function canRead() { return isMember() || isOwner(); }

    // Who owns the trip. The first person to set it up claims it; it can never be changed from the app.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Members and their roles.
    match /members/{uid} {
      allow read: if canRead() || (signedIn() && request.auth.uid == uid);
      // Join: the owner makes themselves admin, everyone else needs a valid invite for that exact role.
      allow create: if signedIn() && request.auth.uid == uid && (
        (isOwner() && request.resource.data.role == 'admin') ||
        (request.resource.data.invite is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.role == request.resource.data.role
          && request.resource.data.role in ['planner', 'traveler'])
      );
      // Admins change roles; anyone can update their own record (e.g. "This is me") but not their role.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Invite links.
    match /invites/{code} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Activity log: Admin + Planners read and add; nobody can edit or delete.
    match /audit/{id} {
      allow read: if isPlanner();
      allow create: if isPlanner() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Uploaded tickets (compressed images / small PDFs).
    match /files/{id} {
      allow read: if canRead();
      allow create: if isPlanner() && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin() || (isPlanner() && resource.data.by == request.auth.uid);
      allow update: if false;
    }

    // Trip data.
    match /{col}/{id} {
      allow read: if canRead() && col in ['days','notes','tasks','people','expenses','rates','meta','wallet','shopping'];
      allow create, update: if isPlanner() && col in ['days','notes','tasks','people','expenses','rates','meta','wallet','shopping'];
      allow delete: if col in ['days','notes','tasks','expenses','rates','meta','wallet','shopping'] && isPlanner()
                    || col == 'people' && isAdmin();
    }
  }
}
